# Optional — only needed if you wire up a real AI backend (see README "Next-Level Upgrades").
# Never put a raw AI provider API key in a client-side .env that ships to the browser;
# route it through a serverless function (Vercel/Netlify Functions) instead.
VITE_AI_BACKEND_URL=

# Optional — only needed if you migrate from localStorage to Firebase/Supabase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
